{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "prod-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APP_BASE_URL=http://localhost:3200",
        "npm",
        "run",
        "start",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
