# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Variables are validated lazily per feature (src/lib/env.ts), so leave the
# ones for features that don't exist yet empty.

# App origin used for share links and Origin checks (no trailing slash)
APP_BASE_URL=http://localhost:3000

# Supabase (M0.3), public: safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (M1.2), SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Customer share-link HMAC secret (M4.3), SERVER ONLY, at least 32 chars
SHARE_LINK_SECRET=

# Web Push (M5.6): public key is public, private key is SERVER ONLY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Supabase Cron -> /api/internal/dispatch bearer (M5.8), SERVER ONLY, at least 32 chars
CRON_SECRET=
