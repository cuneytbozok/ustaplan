-- Supabase Vault secrets for the dispatcher schedule (migration `cron`,
-- DATA_MODEL §7). Run ONCE per project in the Supabase dashboard → SQL Editor,
-- after replacing both placeholders. Never commit the filled-in version.
--   <APP_BASE_URL>: the app's public origin, e.g. https://ustaplan.vercel.app (no trailing slash)
--   <CRON_SECRET>:  the same value as CRON_SECRET in Vercel (Production)

select vault.create_secret('<APP_BASE_URL>', 'app_base_url', 'UstaPlan dispatcher base URL');
select vault.create_secret('<CRON_SECRET>', 'cron_secret', 'Bearer secret for /api/internal/dispatch');

-- To change a value later:
--   select vault.update_secret((select id from vault.secrets where name = 'cron_secret'), '<NEW_CRON_SECRET>');
-- Check (shows names only):
--   select name, created_at from vault.secrets where name in ('app_base_url', 'cron_secret');
